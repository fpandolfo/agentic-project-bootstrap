{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fpandolfo/agentic-project-bootstrap/agentic-project.schema.json",
  "title": "Agentic Project Bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "packs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "description", "stack"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "stack": { "type": "string", "minLength": 1 }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "humanGates": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
